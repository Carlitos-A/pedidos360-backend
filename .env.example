# Copy this file to .env. Replace RabbitMQ credentials before starting it.
RABBITMQ_ERLANG_COOKIE=replace-with-a-long-random-shared-cookie
RABBITMQ_DEFAULT_USER=pedidos360
RABBITMQ_DEFAULT_PASS=replace-with-a-long-unique-password
RABBITMQ_BIND_ADDRESS=127.0.0.1
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Kafka Compose: localhost for applications on this host. For another VPC host,
# set both values to the broker host's private address and restrict its SG.
KAFKA_BIND_ADDRESS=127.0.0.1
KAFKA_ADVERTISED_HOST=localhost
KAFKA_UI_BIND_ADDRESS=127.0.0.1
KAFKA_UI_PORT=8080
