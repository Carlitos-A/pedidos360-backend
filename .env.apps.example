# Copy to .env.apps on the private application host. Never commit real values.
# docker compose --env-file .env.apps -f docker-compose.apps.yml up -d --build
APP_BIND_ADDRESS=127.0.0.1
FRONT_URL=https://your-cloudfront-domain.cloudfront.net
ENTRA_TENANT_ID=replace-with-tenant-guid
ENTRA_API_AUDIENCE=api://replace-with-api-app-guid
INTERNAL_SERVICE_KEY=replace-with-long-random-value
REQUIRE_WRITE_SCOPE=true

DB_HOST=replace-with-private-rds-endpoint
DB_PORT=3306
PEDIDOS_DB_USER=pedidos_app
PEDIDOS_DB_PASSWORD=replace-me
PRODUCTOS_DB_USER=productos_app
PRODUCTOS_DB_PASSWORD=replace-me
REPORT_DB_USER=report_app
REPORT_DB_PASSWORD=replace-me
AUDIT_DB_USER=audit_app
AUDIT_DB_PASSWORD=replace-me

# Broker advertised addresses must also be reachable from the containers.
KAFKA_BOOTSTRAP_SERVERS=10.0.2.10:9092,10.0.2.10:9093,10.0.2.10:9094
RABBITMQ_HOST=10.0.2.11
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=pedidos360
RABBITMQ_PASSWORD=replace-me
RABBITMQ_VHOST=/pedidos360

GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
API_SERVICE_PRINCIPAL_ID=
CUSTOMER_ROLE_ID=
ENTRA_SIGNINS_ENABLED=false
ENTRA_SPA_APP_ID=
OPTIONAL_WORK_ENABLED=false
RABBIT_DLQ_MONITOR_ENABLED=true
